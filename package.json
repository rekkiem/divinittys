{
  "name": "divinittys",
  "version": "1.0.0",
  "description": "DIVINITTYS - Beauty E-Commerce Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "import:products": "npx tsx scripts/import-products.ts",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/tests/smoke/",
    "search:reindex": "npx tsx scripts/reindex-search.ts",
    "health": "npx tsx scripts/health-check.ts",
    "test:unit": "vitest run src/tests/unit/",
    "test:integration": "vitest run src/tests/integration/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "vitest run && playwright test",
    "import:ml": "npx tsx scripts/import-ml-products.ts && npx tsx scripts/migrate-ml-variants.ts",
    "import:ml:dry": "npx tsx scripts/import-ml-products.ts --dry-run && npx tsx scripts/migrate-ml-variants.ts --dry-run",
    "migrate:ml-variants": "npx tsx scripts/migrate-ml-variants.ts",
    "migrate:ml-variants:dry": "npx tsx scripts/migrate-ml-variants.ts --dry-run",
    "sync:ml-stock": "npx tsx scripts/sync-ml-stock.ts",
    "migrate:images": "npx tsx scripts/migrateImages.ts",
    "minio:setup": "npx tsx scripts/setupMinio.ts",
    "fix:deploy": "npx tsx scripts/fixDeploy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.600.0",
    "@aws-sdk/s3-request-presigner": "3.600.0",
    "@bull-board/api": "6.20.5",
    "@bull-board/hono": "6.20.5",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-accordion": "1.2.0",
    "@radix-ui/react-avatar": "1.1.0",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-popover": "1.1.1",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slider": "1.2.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.0",
    "@radix-ui/react-tabs": "1.1.0",
    "@radix-ui/react-toast": "1.2.1",
    "@radix-ui/react-tooltip": "1.1.2",
    "@tanstack/react-query": "5.50.1",
    "@tanstack/react-table": "8.21.3",
    "autoprefixer": "10.4.19",
    "axios": "1.7.2",
    "bcryptjs": "2.4.3",
    "bullmq": "5.71.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "framer-motion": "11.3.2",
    "ioredis": "5.4.1",
    "jose": "5.6.3",
    "lucide-react": "0.408.0",
    "meilisearch": "0.44.0",
    "mercadopago": "2.0.7",
    "minio": "8.0.0",
    "next": "14.2.35",
    "next-themes": "0.3.0",
    "nodemailer": "6.9.14",
    "openai": "4.53.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "14.2.3",
    "react-hook-form": "7.52.1",
    "react-hot-toast": "2.4.1",
    "sharp": "0.33.4",
    "slugify": "1.6.6",
    "tailwind-merge": "2.4.0",
    "tailwindcss": "3.4.4",
    "tailwindcss-animate": "1.0.7",
    "transbank-sdk": "6.1.1",
    "xlsx": "0.18.5",
    "zod": "3.23.8",
    "zustand": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.0",
    "@types/nodemailer": "6.4.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/supertest": "6.4.6",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.35",
    "msw": "^2.12.13",
    "prisma": "^6.2.1",
    "supertest": "7.0.0",
    "tsx": "4.15.0",
    "typescript": "5.5.2",
    "vitest": "2.1.9"
  }
}
