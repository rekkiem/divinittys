# ============================================================
# DIVINITTYS - Configuración Local
# ============================================================
# Puertos expuestos al HOST (tu máquina).
# Si algún puerto ya está ocupado, cámbialo aquí.
# La app siempre se conecta a Redis/Postgres por nombre interno
# de Docker, no por los puertos del host.
# ============================================================

# --- Puertos (cambia si están ocupados) ---
PORT_APP=3001
PORT_POSTGRES=5434
PORT_REDIS=6380          # ← Cambiado a 6380 para evitar conflicto con Redis local
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Base de datos ---
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=divinittys_secret
POSTGRES_DB=divinittys
DATABASE_URL=postgresql://divinittys:divinittys_secret@postgres:5432/divinittys

# --- Redis (la app usa nombre interno de Docker, no el puerto del host) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=divinittys_super_secret_jwt_key_local_dev_2024
JWT_REFRESH_SECRET=divinittys_super_secret_refresh_key_local_dev_2024

# --- OpenAI (opcional — el chat IA funciona sin clave en modo mock) ---
OPENAI_API_KEY=

# --- Transbank Webpay (claves de integración incluidas para testing) ---
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_ENV=integration

# --- MercadoPago (opcional) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# --- Bluexpress (opcional — cotizaciones mock si está vacío) ---
BLUEXPRESS_API_KEY=
BLUEXPRESS_ACCOUNT=

# --- MinIO Storage ---
MINIO_ROOT_USER=divinittys_admin
MINIO_ROOT_PASSWORD=divinittys_secret_2024
