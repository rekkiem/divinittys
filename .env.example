# ============================================
# DIVINITTYS - Environment Variables
# ============================================
# Copy this file to .env and fill in values

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DIVINITTYS
NODE_ENV=development

# --- Database ---
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=divinittys_secret
POSTGRES_DB=divinittys
DATABASE_URL="postgresql://divinittys:divinittys_secret@localhost:5432/divinittys"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change_me_to_a_very_long_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_another_very_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Transbank (Webpay) ---
# Integration: use test keys below
# Production: get from transbank.cl
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_ENV=integration
# TRANSBANK_ENV=production

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_PUBLIC_KEY=TEST-...

# --- Bluexpress ---
BLUEXPRESS_API_KEY=your_bluexpress_api_key
BLUEXPRESS_ACCOUNT=your_bluexpress_account

# --- MinIO (Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=divinittys_admin
MINIO_SECRET_KEY=divinittys_secret_2024
MINIO_ROOT_USER=divinittys_admin
MINIO_ROOT_PASSWORD=divinittys_secret_2024
MINIO_BUCKET=divinittys-products

# --- Email (Optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@divinittys.cl
SMTP_PASS=your_smtp_password
EMAIL_FROM="DIVINITTYS <no-reply@divinittys.cl>"
