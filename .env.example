# ============================================================
# DIVINITTYS - Environment Variables
# Copy to .env for local development and fill the placeholders.
# Do not commit real secrets.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DIVINITTYS
RUNNING_IN_DOCKER=false

# --- Logging ---
LOG_DIR=log
LOG_TO_FILE=true
LOG_CONSOLE_CAPTURE=true
LOG_DEPLOYMENT_DATE=
LOG_DEPLOYMENT_ID=
DEPLOYMENT_DATE=
DEPLOYED_AT=
RELEASE_CREATED_AT=

# --- Database ---
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_DB=divinittys
DATABASE_URL=postgresql://divinittys:change_me_local_postgres_password@localhost:5432/divinittys?schema=public

# --- Redis / queues ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=change_me_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Admin bootstrap (used by prisma/seed.ts) ---
ADMIN_EMAIL=admin@divinittys.cl
ADMIN_PASSWORD=change_me_local_admin_password
PLAYWRIGHT_ADMIN_EMAIL=admin@divinittys.cl
PLAYWRIGHT_ADMIN_PASSWORD=change_me_local_admin_password

# --- OpenAI ---
OPENAI_API_KEY=

# --- Transbank (Webpay) ---
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Bluexpress ---
BLUEXPRESS_API_KEY=
BLUEXPRESS_ACCOUNT=

# --- Meilisearch ---
MEILI_MASTER_KEY=change_me_meilisearch_master_key
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=change_me_meilisearch_master_key

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_ROOT_USER=change_me_minio_access_key
MINIO_ROOT_PASSWORD=change_me_minio_secret_key
MINIO_BUCKET=divinittys-products
MINIO_PUBLIC_URL=http://localhost:3000/media

# --- Local port overrides for docker-compose.yml ---
PORT_APP=3000
PORT_POSTGRES=5432
PORT_MEILI=7700
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001
