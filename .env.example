# ============================================================
# DIVINITTYS — .env.example
# Copia a .env (local) o .env.production (producción)
# NUNCA commitees archivos con valores reales
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DIVINITTYS
DOMAIN=localhost

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=divinittys_secret
POSTGRES_DB=divinittys
DATABASE_URL=postgresql://divinittys:divinittys_secret@postgres:5432/divinittys?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Meilisearch ──────────────────────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=your_meili_master_key_here
MEILISEARCH_API_KEY=your_meili_master_key_here

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=imagenes
MINIO_PUBLIC_URL=http://localhost:9000

# ── Auth ─────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_64_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_minimum_64_chars_here

# ── Pagos ────────────────────────────────────────────────────
TRANSBANK_ENV=integration
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
MERCADOPAGO_ACCESS_TOKEN=your_mp_token_here

# ── APIs opcionales ──────────────────────────────────────────
OPENAI_API_KEY=
BLUEXPRESS_API_KEY=

# ── Puertos (Docker Compose local) ───────────────────────────
PORT_APP=3000
PORT_POSTGRES=5432
PORT_MEILI=7700
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001
