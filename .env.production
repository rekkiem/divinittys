# ============================================================
# DIVINITTYS - Production Environment Template
# Domain: divinittys.cl
#
# Replace every __CHANGE_ME__ value before deploying.
# For Docker Compose deploys, pass this file with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ============================================================

# --- App ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://divinittys.cl
NEXT_PUBLIC_APP_NAME=DIVINITTYS
DOMAIN=divinittys.cl

# --- Logging ---
LOG_DIR=log
LOG_TO_FILE=false
LOG_CONSOLE_CAPTURE=true
LOG_DEPLOYMENT_DATE=
LOG_DEPLOYMENT_ID=
DEPLOYMENT_DATE=
DEPLOYED_AT=
RELEASE_CREATED_AT=

# --- PostgreSQL ---
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=__CHANGE_ME_POSTGRES_PASSWORD__
POSTGRES_DB=divinittys
DATABASE_URL=postgresql://divinittys:__CHANGE_ME_POSTGRES_PASSWORD__@postgres:5432/divinittys?schema=public

# --- Redis / queues ---
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=__CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64__
JWT_REFRESH_SECRET=__CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64__
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@divinittys.cl
ADMIN_PASSWORD=__CHANGE_ME_ADMIN_PASSWORD__
PLAYWRIGHT_ADMIN_EMAIL=admin@divinittys.cl
PLAYWRIGHT_ADMIN_PASSWORD=__CHANGE_ME_ADMIN_PASSWORD__

# --- OpenAI ---
OPENAI_API_KEY=

# --- Transbank (Webpay production credentials) ---
TRANSBANK_ENV=production
TRANSBANK_COMMERCE_CODE=__CHANGE_ME_TRANSBANK_COMMERCE_CODE__
TRANSBANK_API_KEY=__CHANGE_ME_TRANSBANK_API_KEY__

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=__CHANGE_ME_MERCADOPAGO_ACCESS_TOKEN__
MERCADOPAGO_PUBLIC_KEY=__CHANGE_ME_MERCADOPAGO_PUBLIC_KEY__
MERCADOPAGO_WEBHOOK_SECRET=__CHANGE_ME_MERCADOPAGO_WEBHOOK_SECRET__

# --- Bluexpress ---
BLUEXPRESS_API_KEY=__CHANGE_ME_BLUEXPRESS_API_KEY__
BLUEXPRESS_ACCOUNT=__CHANGE_ME_BLUEXPRESS_ACCOUNT__

# --- Meilisearch ---
MEILI_MASTER_KEY=__CHANGE_ME_MEILISEARCH_MASTER_KEY__
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=__CHANGE_ME_MEILISEARCH_MASTER_KEY__

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=__CHANGE_ME_MINIO_ACCESS_KEY__
MINIO_SECRET_KEY=__CHANGE_ME_MINIO_SECRET_KEY__
MINIO_ROOT_USER=__CHANGE_ME_MINIO_ACCESS_KEY__
MINIO_ROOT_PASSWORD=__CHANGE_ME_MINIO_SECRET_KEY__
MINIO_BUCKET=divinittys-products
MINIO_PUBLIC_URL=https://divinittys.cl/media

# --- Production port bindings ---
PORT_POSTGRES=127.0.0.1:5432
PORT_MEILI=127.0.0.1:7700
PORT_MINIO=127.0.0.1:9000
PORT_MINIO_CONSOLE=127.0.0.1:9001
