# ============================================================
# DIVINITTYS — .env.production (Vultr)
# ⚠️  NO commitear — está en .gitignore
# Reemplaza TODOS los __CHANGE_ME__ antes de deploy
# Genera secrets con: bash scripts/generate-secrets.sh
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=https://divinittys.cl
NEXT_PUBLIC_APP_NAME=DIVINITTYS
DOMAIN=divinittys.cl
RUNNING_IN_DOCKER=true
PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=divinittys
POSTGRES_PASSWORD=__CHANGE_ME_POSTGRES_PASSWORD__
POSTGRES_DB=divinittys
DATABASE_URL=postgresql://divinittys:__CHANGE_ME_POSTGRES_PASSWORD__@postgres:5432/divinittys?schema=public

# ── Redis (con password en producción) ───────────────────────
REDIS_PASSWORD=__CHANGE_ME_REDIS_PASSWORD__
REDIS_URL=redis://:__CHANGE_ME_REDIS_PASSWORD__@redis:6379

# ── Meilisearch ──────────────────────────────────────────────
MEILI_MASTER_KEY=__CHANGE_ME_MEILI_KEY__
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=__CHANGE_ME_MEILI_KEY__

# ── MinIO (imágenes) ─────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=divinittys_admin
MINIO_SECRET_KEY=__CHANGE_ME_MINIO_SECRET__
MINIO_BUCKET=imagenes
MINIO_PUBLIC_URL=https://media.divinittys.cl

# ── Auth JWT ─────────────────────────────────────────────────
JWT_SECRET=__CHANGE_ME_JWT_SECRET_128_HEX__
JWT_REFRESH_SECRET=__CHANGE_ME_JWT_REFRESH_128_HEX__

# ── Pagos ────────────────────────────────────────────────────
TRANSBANK_ENV=production
TRANSBANK_COMMERCE_CODE=__CHANGE_ME_COMMERCE_CODE__
TRANSBANK_API_KEY=__CHANGE_ME_TRANSBANK_API_KEY__
MERCADOPAGO_ACCESS_TOKEN=__CHANGE_ME_MP_TOKEN__

# ── APIs opcionales ───────────────────────────────────────────
OPENAI_API_KEY=
BLUEXPRESS_API_KEY=
